# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" al repositorio.

# Conexión a MongoDB Atlas (en desuso — se conserva por si hace falta rollback)
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB_NAME=icgdb

# Conexión a SQL Server
# SQL_AUTH=windows -> usa autenticación de Windows (Trusted_Connection), no requiere SQL_USER/SQL_PASSWORD.
# SQL_AUTH=sql     -> usa usuario/contraseña de SQL Server, completa SQL_USER y SQL_PASSWORD.
SQL_SERVER=localhost
SQL_DATABASE=icgdb
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH=windows
SQL_USER=
SQL_PASSWORD=

# Clave secreta de Flask (genera una larga y aleatoria para producción)
SECRET_KEY=cambia-esto-por-una-clave-segura

# OSRM: usa la instancia pública o tu servidor local
OSRM_HOST=https://router.project-osrm.org
